# =============================================================================
# BACKEND API
# NEXT_PUBLIC_* values are visible to browser code. Never put secrets in them.
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# =============================================================================
# DASHBOARD COOKIES
# Names only; authentication values are stored in the cookies at runtime.
# =============================================================================
ADMIN_SESSION_COOKIE=admin_session
ADMIN_LOCALE_COOKIE=admin_locale
ADMIN_THEME_COOKIE=admin_theme
